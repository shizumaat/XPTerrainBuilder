{
  "permissions": {
    "allow": [
      "Bash(Ortho4XP/venv/bin/python tools/blast.py:*)",
      "Bash(./scripts/make_engine.sh)",
      "Bash(swift build:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git stash list:*)",
      "Bash(git stash show:*)",
      "Bash(venv/bin/python tools/run_with_ledger.py --history:*)",
      "Bash(venv/bin/python tools/check_grade.py:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash_guard.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/read_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/agent_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory_index_check.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
