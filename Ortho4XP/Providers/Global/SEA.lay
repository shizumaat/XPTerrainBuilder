# IGN Geoplateforme orthophotos (open service, no API key): the sea overlay's
# low-resolution layer. Replaces the retired wxs.ign.fr keyed API (#862).
request_type=tms
grid_type=webmercator
url_template=https://data.geopf.fr/wmts?SERVICE=WMTS&VERSION=1.0.0&REQUEST=GetTile&LAYER=ORTHOIMAGERY.ORTHOPHOTOS&STYLE=normal&FORMAT=image/jpeg&TILEMATRIXSET=PM&TILEMATRIX={zoom}&TILEROW={y}&TILECOL={x}
max_zl=12
imagery_dir=code
color_filter=SEA
