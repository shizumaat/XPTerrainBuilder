# RETIRED (#1339): the koordinates/fastly tile endpoint this used is dead.
# Kept only so tiles built from it still resolve (their textures are named
# _NZ<zl>): it is never offered, and a tile whose textures say NZ is offered
# its replacement, LINZ (Toitū Te Whenua LINZ Basemaps, LINZ.lay).
grid_type=webmercator
url_template=https://koordinates-tiles-{switch:a,b,c,d}.global.ssl.fastly.net/services;key=ec2d27e902f1463c9145743576e03f31/tiles/v4/layer=51769,style=auto;layer=88131,style=auto;layer=95497,style=auto/{z}/{x}/{y}.png
max_threads=8
imagery_dir=code
in_GUI=False
replaced_by=LINZ
