{
  "_doc": "The Activity list's row order and status tone (#1341), the section a row sits in (#1556), which engine queue notices open a row (#2030) and which rows the list shows selected and the map selection after a list edit (#1537). Read by Ortho4XP/tests/test_activity_order.py (O4_Activity_Order) and Tests/SceneryKitTests/ActivityOrderTests.swift (SceneryKit ActivityOrder). Each sequence starts with no stamps and counter 0; each step lists every row [key, state, label] in the order the rows were made, and the order the list shows after it: live rows first-queued at the top, new and re-queued rows appended below (#1605), then finished rows in finish order.",
  "section": [
    {"state": "done", "section": "completed"},
    {"state": "error", "section": "activity"},
    {"state": "stopped", "section": "activity"},
    {"state": "queued", "section": "activity"},
    {"state": "active", "section": "activity"},
    {"state": "indeterminate", "section": "activity"}
  ],
  "shown": [
    {"name": "subset: the selected rows show selected",
     "rows": ["a", "b", "c"], "selected": ["a", "b"], "shown": ["a", "b"]},
    {"name": "every row selected: every row shows it",
     "rows": ["a", "b"], "selected": ["a", "b"], "shown": ["a", "b"]},
    {"name": "tiles off the list are not rows",
     "rows": ["a", "b"], "selected": ["a", "z"], "shown": ["a"]},
    {"name": "nothing selected",
     "rows": ["a", "b"], "selected": [], "shown": []},
    {"name": "no rows",
     "rows": [], "selected": ["a"], "shown": []}
  ],
  "list_edit": [
    {"name": "a click on one row selects it alone, active, framed",
     "new": ["b"], "shown": ["a"], "active": "a",
     "selected": ["b"], "to_active": "b", "frame": true},
    {"name": "a click on a row already shown among others: alone, framed",
     "new": ["a"], "shown": ["a", "b"], "active": "b",
     "selected": ["a"], "to_active": "a", "frame": true},
    {"name": "command-click adds a row: it becomes active",
     "new": ["a", "c"], "shown": ["a"], "active": "a",
     "selected": ["a", "c"], "to_active": "c", "frame": false},
    {"name": "command-click removes the active row: the first stays active",
     "new": ["b", "c"], "shown": ["a", "b", "c"], "active": "a",
     "selected": ["b", "c"], "to_active": "b", "frame": false},
    {"name": "shift-click adds a range: the active tile stays",
     "new": ["a", "b", "c"], "shown": ["a"], "active": "a",
     "selected": ["a", "b", "c"], "to_active": "a", "frame": false},
    {"name": "deselect everything",
     "new": [], "shown": ["a"], "active": "a",
     "selected": [], "to_active": null, "frame": false}
  ],
  "finished": [
    {"state": "queued", "label": "queued", "finished": false},
    {"state": "active", "label": "mesh", "finished": false},
    {"state": "indeterminate", "label": "starting…", "finished": false},
    {"state": "queued", "label": "resumes after current run", "finished": false},
    {"state": "done", "label": "done", "finished": true},
    {"state": "done", "label": "built with warnings", "finished": true},
    {"state": "error", "label": "failed", "finished": true},
    {"state": "stopped", "label": "stopped", "finished": true},
    {"state": "queued", "label": "stopped", "finished": true}
  ],
  "opens_row": [
    {"name": "an engine-queued tile with no row opens one", "state": "queued", "label": "queued", "row": null, "opens": true},
    {"name": "a finished row is queued again", "state": "queued", "label": "queued", "row": ["done", "done"], "opens": true},
    {"name": "a stopped row is queued again", "state": "queued", "label": "queued", "row": ["stopped", "stopped"], "opens": true},
    {"name": "a live row is left as it is", "state": "queued", "label": "queued", "row": ["active", "mesh"], "opens": false},
    {"name": "the app's own queued row is left as it is", "state": "queued", "label": "queued", "row": ["queued", "queued"], "opens": false},
    {"name": "the drained notice never opens a row", "state": "queued", "label": "stopped", "row": null, "opens": false},
    {"name": "progress never opens a row", "state": "active", "label": "mesh", "row": null, "opens": false},
    {"name": "a terminal never opens a row", "state": "done", "label": "done", "row": null, "opens": false}
  ],
  "tones": [
