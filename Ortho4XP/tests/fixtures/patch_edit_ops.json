{
 "about": "Twin fixture of the patch editor's edit operations (spec Ortho4XP/docs/specs/patch-editor-20261015.md section 3). Run by pytest (tests/test_patch_edit.py over o4_engine/patch_edit.py) and by swift test (SceneryKit/PatchDocument.swift). Each case: start from doc, apply ops in order, compare with expect.",
 "schema": "{cases: [{name, origin, doc: {nodes, ways}, ops: [{op, args}], expect: {nodes, ways}}]}; a node is [id, lat, lon, alt|null] (degrees, metres MSL), a way {id, refs, tags}; a closed way repeats its first ref last.",
 "compare": "nodes and ways in order; ids and refs exactly; lat/lon within tolerance.deg; alt within tolerance.m (null equals only null); tags exactly.",
 "tolerance": {
  "deg": 1e-09,
  "m": 1e-06
 },
 "min_distinct_spacing_m": 0.5,
 "identity_dp": 11,
 "rules": {
  "origin": "the centre of the bbox of the doc's nodes AS LOADED: ((min lat + max lat) / 2, (min lon + max lon) / 2), fixed for the document's life (each case states it as origin).",
  "local_plane": "metres per degree lat = 111320.0; metres per degree lon = 111320.0 * max(cos(origin lat in radians), 1e-6) (osm_adapter._local_metres); distance = hypot(dlat * m_lat, dlon * m_lon).",
  "snap": "only move and set_position snap, only the moved nodes: a moved node whose distance to a NON-moved node is strictly less than min_distinct_spacing_m merges into the nearest one (that node keeps its position and alt; refs are replaced); an exact distance tie goes to the lowest survivor_key = (round(lat, identity_dp), round(lon, identity_dp)) compared lexicographically.",
  "topology": "after every op: consecutive duplicate refs collapse (cyclically on a closed way); a closed way with < 3 distinct nodes or an open way with < 2 is removed; nodes it leaves behind are kept.",
  "insert_on_edge": "new node at the midpoint, alt = mean of the ends (null if either is null), id = min(0, min node id) - 1, appended after the existing nodes, inserted into every way where a and b are consecutive in either direction; never snaps.",
  "offset_alt": "a node with alt null keeps null."
 },
