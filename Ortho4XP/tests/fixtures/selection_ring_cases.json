{
  "_doc": "Which Activity rows draw the map's selection ring (#1537). Read by Tests/SceneryKitTests/SelectionRingTests.swift and Ortho4XP/tests/test_qt_selection_ring.py.",
  "cases": [
    {"name": "subset: the selected rows ring, the active one solid",
     "rows": ["a", "b", "c"], "selected": ["a", "b"], "active": "a",
     "rings": {"a": "active", "b": "other"}},
    {"name": "every row selected: none ring",
     "rows": ["a", "b"], "selected": ["a", "b"], "active": "a", "rings": {}},
    {"name": "every row selected plus tiles off the list: none ring",
     "rows": ["a", "b"], "selected": ["a", "b", "z"], "active": "z", "rings": {}},
    {"name": "nothing selected: none ring",
     "rows": ["a", "b"], "selected": [], "active": null, "rings": {}},
    {"name": "selection off the list: none ring",
     "rows": ["a", "b"], "selected": ["z"], "active": "z", "rings": {}},
    {"name": "active tile off the list: the selected row dashes",
     "rows": ["a", "b"], "selected": ["a", "z"], "active": "z",
     "rings": {"a": "other"}},
    {"name": "a lone row: never rings",
     "rows": ["a"], "selected": ["a"], "active": "a", "rings": {}},
    {"name": "no rows",
     "rows": [], "selected": ["a"], "active": "a", "rings": {}}
  ]
}
