<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime entitlements for XPTerrainBuilder.app and every Mach-O the
  frozen engine carries (scripts/sign_app.sh signs them all with THIS file).

  Each entry below is here because a measured failure asked for it.  Do not
  add one speculatively: record the failing command in the commit message.

  - allow-unsigned-executable-memory: CPython's own interpreter loop and the
    ctypes/libffi trampolines allocate writable-executable pages; under the
    hardened runtime without this the frozen engine is SIGKILLed by AMFI.
  - disable-library-validation: the engine dlopen()s dylibs that are NOT
    part of this bundle's signature at all (GDAL / PROJ / imagecodecs load
    their own .dylibs by path through ctypes, and the Utils/mac helper
    binaries are separate processes with their own team).  Library
    validation rejects any dylib whose team identifier differs.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
